# ============================================================
# SiruzTec — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# ── Anthropic (obrigatório) ──────────────────────────────────
# Crie sua chave em: https://console.anthropic.com
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# ── Supabase (obrigatório) ───────────────────────────────────
# Crie um projeto em: https://supabase.com
# Settings → API → URL e anon key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Settings → API → service_role key (nunca expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe (obrigatório para billing) ───────────────────────
# Crie sua conta em: https://stripe.com
# Developers → API Keys
STRIPE_SECRET_KEY=sk_live_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx
# Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# IDs dos preços Stripe (Produto → Preços → copie o Price ID)
STRIPE_STARTUP_PRICE_ID=price_xxxx
STRIPE_SCALE_PRICE_ID=price_xxxx
STRIPE_DOMINANCE_PRICE_ID=price_xxxx

# ── App ──────────────────────────────────────────────────────
# URL base do app (sem barra no final)
# Em produção: https://siruztec.com.br
# Em local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://siruztec.com.br

# ── Admin ────────────────────────────────────────────────────
# Email do dono que acessa /admin
ADMIN_EMAIL=seu@email.com
